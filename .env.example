# ===== Renova & Delve 환경변수 =====
# 이 파일을 .env로 복사한 뒤 값을 채워주세요.

# JWT 서명 키 (충분히 긴 임의의 문자열, 최소 32바이트)
JWT_SECRET_KEY=change_me_to_a_very_long_random_secret_key_1234567890

# OpenAI API Key (임베딩 text-embedding-3-small / 챗 gpt-4o-mini)
OPENAI_API_KEY=sk-your-openai-api-key

# 최초 관리자 계정 (관리자가 한 명도 없을 때만 생성됨)
# ADMIN_PASSWORD를 비워두면 서버가 임의 비밀번호를 생성해 기동 로그에 1회만 출력합니다.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=

# ----- 아래는 선택 사항 (미지정 시 로컬 개발 기본값 사용) -----
# DB / Redis 접속 정보
# DB_URL=jdbc:postgresql://localhost:5432/renova_n_delve?currentSchema=public
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# REDIS_HOST=localhost
# REDIS_PORT=6379

# 메일 발송 (아이디 찾기 / 비밀번호 재설정). 비워 두면 서버는 기동되고 메일만 나가지 않습니다.
# 네이버: 메일 > 환경설정 > POP3/IMAP 설정에서 "POP3/SMTP 사용"을 켜야 합니다.
#         2단계 인증을 쓰면 네이버 계정의 "애플리케이션 비밀번호"를 발급받아 MAIL_PASSWORD에 넣습니다.
# MAIL_USERNAME=your_naver_id
# MAIL_PASSWORD=
# 보내는 주소. 비워 두면 MAIL_USERNAME@naver.com 으로 보냅니다 (네이버는 본인 주소로만 발송 가능).
# MAIL_FROM=your_naver_id@naver.com
# 기본값은 smtp.naver.com:465 (SSL). 587(STARTTLS)을 쓰려면 MAIL_PORT=587, MAIL_SSL=false
# MAIL_HOST=smtp.naver.com
# MAIL_PORT=465
# MAIL_SSL=true
# 메일의 재설정 링크가 가리킬 프론트 주소 (운영에서는 실제 도메인)
# APP_BASE_URL=http://localhost:5173

# Google OAuth2 (구글 로그인을 쓸 때만)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# HTTPS 환경에서는 true (RefreshToken 쿠키 Secure 속성)
# COOKIE_SECURE=false
