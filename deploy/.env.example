# ===== 서버 배포용 환경변수 =====
# 서버에서 docker-compose.yml 옆에 .env로 복사한 뒤 값을 채운다. 이 파일에는 값을 적지 않는다.

# 이미지 태그 (비우면 latest)
APP_TAG=

# DB (rd_db 컨테이너를 처음 만들 때 이 값으로 계정이 생긴다)
DB_NAME=renova_n_delve
DB_USERNAME=renova
DB_PASSWORD=

# 필수
JWT_SECRET_KEY=
OPENAI_API_KEY=
# 메일 링크와 화면 주소 (예: https://renova-delve.duckdns.org)
APP_BASE_URL=
# 최초 관리자 비밀번호 (운영 프로파일에서는 필수)
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=

# 메일 (비우면 메일만 나가지 않는다)
MAIL_USERNAME=
MAIL_PASSWORD=
